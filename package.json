{
  "name": "orus-pilot-calc-cli",
  "version": "0.1.0",
  "description": "A tiny calculator command line, the consumer in the orus pilot",
  "type": "module",
  "bin": {
    "calc": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run typecheck && node --test \"test/**/*.test.ts\""
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "orus-pilot-calc": "github:zkorus/orus-pilot-calc#v0.1.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
